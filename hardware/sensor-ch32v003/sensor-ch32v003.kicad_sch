	(text "U1 pin use: PC1/PC2 = hardware I2C to the upstream connector J1."
		(exclude_from_sim no)
		(at 20.32 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c8e6c0aa-ccf5-5ce8-b2b1-59e4da19d7c0")
	)
	(text "PA1 and PC4 = bit-banged I2C controller to J2, used only in relay mode."
		(exclude_from_sim no)
		(at 20.32 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "015e91e4-11fd-5c84-b79a-a0a33f11054a")
	)
	(text "PA2 = ADC channel 0 on the thermistor divider.  PD1 = SWIO programming pin,"
		(exclude_from_sim no)
		(at 20.32 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2b7b230d-e90a-5c51-b720-3d54cf3da234")
	)
	(text "shared with the identify LED (drive PD4 or PD5 low to light it)."
		(exclude_from_sim no)
		(at 20.32 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a73eca5a-cd9f-5430-b1e8-67aff7a5ed0b")
	)
	(text "Chain wiring is a build option:"
		(exclude_from_sim no)
		(at 20.32 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36ee7b59-407b-5be5-b0a2-279174559efd")
	)
	(text "  Relay (default): R5 and R6 (4k7) fitted as the pull-ups of the hop to the next board.  R3 and R4 unfitted."
		(exclude_from_sim no)
		(at 20.32 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e2e5590d-b75b-5980-b5b8-5044eb7d7731")
	)
	(text "  Shared bus: fit R3 and R4 (0R) and remove R5 and R6.  The only pull-ups are then the ones on the hub."
		(exclude_from_sim no)
		(at 20.32 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85da3bb1-568b-5ea5-9065-7e959396bed6")
	)
	(text "The hop from the hub to the first board uses the pull-ups on the hub."
