		(uuid "9074bf1f-b3f5-5bb0-a129-88a63a9a5953")
	)
	(text "PA2 = identify LED (active low).  PA1 (ADC channel 1) and PC6 = spare pins on pads."
		(exclude_from_sim no)
		(at 20.32 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c6f7363c-55af-5766-a10b-4e046a4c5513")
	)
	(text "Chain wiring is a build option:"
		(exclude_from_sim no)
		(at 20.32 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc197832-74a2-5bb6-8c1d-183758b6a043")
	)
	(text "  Relay (default): R3 and R4 unfitted.  R5 and R6 (4k7) are the pull-ups of the hop to the next board."
		(exclude_from_sim no)
		(at 20.32 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "16d2230e-d659-582e-ba4c-12463c87ca70")
	)
	(text "  R5 and R6 are optional: without them firmware uses the internal pull-ups (35 to 55 k) at low speed."
		(exclude_from_sim no)
		(at 20.32 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "393a56c3-47e0-5a28-89ec-6c4a9a847c22")
	)
	(text "  Shared bus: fit R3 and R4 (0R) and remove R5 and R6.  The only pull-ups are then the ones on the hub."
		(exclude_from_sim no)
		(at 20.32 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "61278e41-e8cb-5bac-8709-767dc4f3fd0b")
	)
	(text "The hop from the hub to the first board uses the pull-ups on the hub."
		(exclude_from_sim no)
		(at 20.32 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b3011e08-7126-52f8-820f-2e7810fa7487")
	)
